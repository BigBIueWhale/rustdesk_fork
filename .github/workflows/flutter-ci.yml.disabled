name: Full Flutter CI

# HISTORICAL INERT REFERENCE ONLY (R-R2/R-R2d). Both workflow authority keys
# are schema-demoted so a rename cannot activate this file.

historical_on:
  workflow_dispatch:
  pull_request:
    paths-ignore:
    - "docs/**"
    - "README.md"
  push:
    branches:
      - master
    paths-ignore:
      - ".github/**"
      - "docs/**"
      - "README.md"
      - "res/**"

historical_jobs:
  run-ci:
    uses: ./.github/workflows/flutter-build.yml
    with:
      upload-artifact: false
