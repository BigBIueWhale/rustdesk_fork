#!/bin/sh

set -e

dpkg-maintscript-helper rm_conffile /etc/rustdesk/startwm.sh -- "$@"
dpkg-maintscript-helper rm_conffile /etc/rustdesk/xorg.conf -- "$@"

unit=rustdesk.service
service=rustdesk

case "$1" in
    purge)
        deb-systemd-helper purge "$unit" >/dev/null
        update-rc.d "$service" remove >/dev/null
        rm -rf -- /root/.config/RustDesk /root/.config/rustdesk
        ;;
esac

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            /bin/systemctl --system daemon-reload >/dev/null
        fi
        ;;
esac

exit 0
