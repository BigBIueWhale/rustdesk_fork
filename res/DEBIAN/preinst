#!/bin/sh

set -e

dpkg-maintscript-helper rm_conffile /etc/rustdesk/startwm.sh -- "$@"
dpkg-maintscript-helper rm_conffile /etc/rustdesk/xorg.conf -- "$@"

unit=rustdesk.service
service=rustdesk

case "$1" in
    upgrade)
        if [ -d /run/systemd/system ]; then
            if [ -e "/etc/systemd/system/$unit" ] || [ -e "/usr/lib/systemd/system/$unit" ] || [ -e "/lib/systemd/system/$unit" ]; then
                deb-systemd-invoke stop "$unit" >/dev/null
            fi
        elif [ -x /etc/init.d/rustdesk ]; then
            invoke-rc.d "$service" stop >/dev/null
        fi
        sleep 1
        ;;
esac

exit 0
