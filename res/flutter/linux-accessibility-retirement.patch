+static gboolean get_node_geometry(FlAccessibleNode* self,
+                                   AtkCoordType coord_type,
+                                   gint* result) {
+  FlAccessibleNodePrivate* priv = FL_ACCESSIBLE_NODE_GET_PRIVATE(self);
+  if (!is_live(priv)) {
+    return FALSE;
+  }
+  g_autoptr(FlSemanticsGeneration) generation =
+      FL_SEMANTICS_GENERATION(g_weak_ref_get(&priv->generation));
+  g_autoptr(GtkAccessible) root = fl_semantics_generation_ref_owner(generation);
+  FlSemanticsViewGeometry view;
+  if (root == nullptr || !fl_semantics_generation_get_view_geometry(
+          generation, coord_type == ATK_XY_PARENT ? ATK_XY_WINDOW : coord_type, &view)) {
+    return FALSE;
+  }
+
+  // Retain every ancestor and reject missing edges, mixed generations and cycles.
+  // No recursive ATK geometry calls or partially rounded parent boxes are used.
+  g_autoptr(GPtrArray) ancestors = g_ptr_array_new_with_free_func(g_object_unref);
+  g_autoptr(GHashTable) visited = g_hash_table_new(g_direct_hash, g_direct_equal);
+  g_autoptr(AtkObject) current = ATK_OBJECT(g_object_ref(self));
+  while (current != ATK_OBJECT(root)) {
+    if (!FL_IS_ACCESSIBLE_NODE(current) || g_hash_table_contains(visited, current)) {
+      return FALSE;
+    }
+    g_hash_table_add(visited, current);
+    FlAccessibleNodePrivate* node = FL_ACCESSIBLE_NODE_GET_PRIVATE(current);
+    g_autoptr(FlSemanticsGeneration) lease =
+        FL_SEMANTICS_GENERATION(g_weak_ref_get(&node->generation));
+    if (!is_live(node) || lease != generation || !node->geometry_set) {
+      return FALSE;
+    }
+    g_autoptr(AtkObject) parent = ATK_OBJECT(g_weak_ref_get(&node->parent));
+    if (parent == nullptr) {
+      return FALSE;
+    }
+    if (FL_IS_ACCESSIBLE_NODE(parent)) {
+      FlAccessibleNodePrivate* parent_node = FL_ACCESSIBLE_NODE_GET_PRIVATE(parent);
+      if (!is_live(parent_node) || !has_child(parent_node->children, current)) {
+        return FALSE;
+      }
+    } else if (parent == ATK_OBJECT(root)) {
+      g_autoptr(AtkObject) root_node = atk_object_ref_accessible_child(parent, 0);
+      if (root_node != current) {
+        return FALSE;
+      }
+    } else {
+      return FALSE;
+    }
+    g_ptr_array_add(ancestors, g_object_ref(current));
+    g_clear_object(&current);
+    current = ATK_OBJECT(g_steal_pointer(&parent));
+  }
+
+  SemanticsMatrix matrix = {{{1, 0, 0}, {0, 1, 0}, {0, 0, 1}}};
+  gint parent_bounds[4] = {0, 0, 0, 0};
+  for (guint i = ancestors->len; i > 0; i--) {
+    FlAccessibleNodePrivate* node = FL_ACCESSIBLE_NODE_GET_PRIVATE(
+        g_ptr_array_index(ancestors, i - 1));
+    SemanticsMatrix composed;
+    FlutterRect bounds;
+    if (!multiply_matrix(matrix, semantics_matrix(node->transform), &composed) ||
+        !transform_rect(node->rect, composed, &bounds)) {
+      return FALSE;
+    }
+    matrix = composed;
+    if (i == 2 && !round_bounds(bounds, view.scale, parent_bounds)) {
+      return FALSE;
+    }
+    if (i == 1 && !round_bounds(bounds, view.scale, result)) {
+      return FALSE;
+    }
+  }
+  gint64 x = static_cast<gint64>(result[0]) +
+      (coord_type == ATK_XY_PARENT ? -static_cast<gint64>(parent_bounds[0]) : view.x);
+  gint64 y = static_cast<gint64>(result[1]) +
+      (coord_type == ATK_XY_PARENT ? -static_cast<gint64>(parent_bounds[1]) : view.y);
+  if (x < G_MININT || x > G_MAXINT || y < G_MININT || y > G_MAXINT ||
+      x + result[2] > G_MAXINT || y + result[3] > G_MAXINT ||
+      !fl_semantics_generation_is_active(generation)) {
+    return FALSE;
+  }
+  result[0] = static_cast<gint>(x);
+  result[1] = static_cast<gint>(y);
+  return TRUE;
+}
