+++ b/engine/src/flutter/shell/platform/linux/fl_semantics_generation.h
@@ -0,0 +1,53 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_SHELL_PLATFORM_LINUX_FL_SEMANTICS_GENERATION_H_
+#define FLUTTER_SHELL_PLATFORM_LINUX_FL_SEMANTICS_GENERATION_H_
+
+#include <gtk/gtk-a11y.h>
+
+#include "flutter/shell/platform/embedder/embedder.h"
+#include "flutter/shell/platform/linux/public/flutter_linux/fl_engine.h"
+
+G_BEGIN_DECLS
+
+G_DECLARE_FINAL_TYPE(FlSemanticsGeneration,
+                     fl_semantics_generation,
+                     FL,
+                     SEMANTICS_GENERATION,
+                     GObject)
+
+// Owned by one semantics tree. All operations run on the GTK thread.
+FlSemanticsGeneration* fl_semantics_generation_new(GtkAccessible* owner,
+                                                   FlEngine* engine,
+                                                   FlutterViewId view_id);
+
+// Returns the exact GTK owner with a strong reference, or NULL after revocation.
+GtkAccessible* fl_semantics_generation_ref_owner(FlSemanticsGeneration* generation);
+
+struct FlSemanticsViewGeometry {
+  gint x, y, width, height, scale;
+};
+
+// Geometry is in GTK logical coordinates. Unmapped/unbound owners are unavailable.
+gboolean fl_semantics_generation_get_view_geometry(
+    FlSemanticsGeneration* generation,
+    AtkCoordType coord_type,
+    FlSemanticsViewGeometry* geometry);
+
+// Irreversibly closes the complete tree, without emitting callbacks.
+void fl_semantics_generation_retire(FlSemanticsGeneration* generation);
+
+gboolean fl_semantics_generation_is_active(FlSemanticsGeneration* generation);
+
+// Returns whether the action was admitted to the engine dispatch sink.
+gboolean fl_semantics_generation_perform_action(
+    FlSemanticsGeneration* generation,
+    int32_t node_id,
+    FlutterSemanticsAction action,
+    GBytes* data);
+
+G_END_DECLS
+
+#endif  // FLUTTER_SHELL_PLATFORM_LINUX_FL_SEMANTICS_GENERATION_H_
