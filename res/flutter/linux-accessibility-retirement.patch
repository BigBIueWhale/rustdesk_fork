+  if (coord_type == ATK_XY_PARENT) {
+    gint left, top;
+    fl_accessible_node_get_position(component, &left, &top, coord_type);
+    gint64 local_x = static_cast<gint64>(x) - left;
+    gint64 local_y = static_cast<gint64>(y) - top;
+    if (local_x < G_MININT || local_x > G_MAXINT ||
+        local_y < G_MININT || local_y > G_MAXINT) {
+      return nullptr;
+    }
+    x = static_cast<gint>(local_x);
+    y = static_cast<gint>(local_y);
+  }
+  FlAccessibleNodePrivate* priv = FL_ACCESSIBLE_NODE_GET_PRIVATE(component);
+  for (guint i = 0; i < priv->children->len; i++) {
+    AtkObject* child = ATK_OBJECT(g_ptr_array_index(priv->children, i));
+    if (ATK_IS_COMPONENT(child) &&
