diff --git a/engine/src/flutter/shell/platform/linux/fl_semantics_generation.cc b/engine/src/flutter/shell/platform/linux/fl_semantics_generation.cc
new file mode 100644
--- /dev/null
+++ b/engine/src/flutter/shell/platform/linux/fl_semantics_generation.cc
@@ -0,0 +1,181 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/linux/fl_semantics_generation.h"
+#include "flutter/shell/platform/linux/fl_engine_private.h"
+
+#ifdef GDK_WINDOWING_X11
+#include <gdk/gdkx.h>
+#endif
+
+struct _FlSemanticsGeneration {
+  GObject parent_instance;
+
+  GWeakRef owner;
+  GWeakRef engine;
+  FlutterViewId view_id;
+  gboolean retired;
+};
+
+G_DEFINE_TYPE(FlSemanticsGeneration, fl_semantics_generation, G_TYPE_OBJECT)
+
+static void fl_semantics_generation_dispose(GObject* object) {
+  fl_semantics_generation_retire(FL_SEMANTICS_GENERATION(object));
+  G_OBJECT_CLASS(fl_semantics_generation_parent_class)->dispose(object);
+}
+
+static void fl_semantics_generation_finalize(GObject* object) {
+  FlSemanticsGeneration* self = FL_SEMANTICS_GENERATION(object);
+  g_weak_ref_clear(&self->owner);
+  g_weak_ref_clear(&self->engine);
+  G_OBJECT_CLASS(fl_semantics_generation_parent_class)->finalize(object);
+}
+
+static void fl_semantics_generation_class_init(
+    FlSemanticsGenerationClass* klass) {
+  G_OBJECT_CLASS(klass)->dispose = fl_semantics_generation_dispose;
+  G_OBJECT_CLASS(klass)->finalize = fl_semantics_generation_finalize;
+}
+
+static void fl_semantics_generation_init(FlSemanticsGeneration* self) {
+  g_weak_ref_init(&self->owner, nullptr);
+  g_weak_ref_init(&self->engine, nullptr);
+  self->retired = TRUE;
+}
+
+FlSemanticsGeneration* fl_semantics_generation_new(GtkAccessible* owner,
+                                                   FlEngine* engine,
+                                                   FlutterViewId view_id) {
+  g_return_val_if_fail(GTK_IS_ACCESSIBLE(owner), nullptr);
+  g_return_val_if_fail(FL_IS_ENGINE(engine), nullptr);
+  g_return_val_if_fail(view_id >= 0, nullptr);
+  if (gtk_accessible_get_widget(owner) == nullptr) {
+    return nullptr;
+  }
+  FlSemanticsGeneration* self = FL_SEMANTICS_GENERATION(
+      g_object_new(fl_semantics_generation_get_type(), nullptr));
+  g_weak_ref_set(&self->owner, owner);
+  g_weak_ref_set(&self->engine, engine);
+  self->view_id = view_id;
+  self->retired = FALSE;
+  return self;
+}
+
+void fl_semantics_generation_retire(FlSemanticsGeneration* self) {
+  g_return_if_fail(FL_IS_SEMANTICS_GENERATION(self));
+  self->retired = TRUE;
+  g_weak_ref_set(&self->owner, nullptr);
+  g_weak_ref_set(&self->engine, nullptr);
+}
+
+gboolean fl_semantics_generation_is_active(FlSemanticsGeneration* self) {
+  g_return_val_if_fail(FL_IS_SEMANTICS_GENERATION(self), FALSE);
+  if (self->retired) {
+    return FALSE;
+  }
+  g_autoptr(FlEngine) engine = FL_ENGINE(g_weak_ref_get(&self->engine));
+  g_autoptr(GtkAccessible) owner = GTK_ACCESSIBLE(g_weak_ref_get(&self->owner));
+  return engine != nullptr && owner != nullptr &&
+         gtk_accessible_get_widget(owner) != nullptr;
+}
+
+GtkAccessible* fl_semantics_generation_ref_owner(FlSemanticsGeneration* self) {
+  g_return_val_if_fail(FL_IS_SEMANTICS_GENERATION(self), nullptr);
+  if (!fl_semantics_generation_is_active(self)) {
+    return nullptr;
+  }
+  return GTK_ACCESSIBLE(g_weak_ref_get(&self->owner));
+}
+
+gboolean fl_semantics_generation_get_view_geometry(
+    FlSemanticsGeneration* self,
+    AtkCoordType coord_type,
+    FlSemanticsViewGeometry* geometry) {
+  g_return_val_if_fail(geometry != nullptr, FALSE);
+  *geometry = {-1, -1, -1, -1, -1};
+  g_autoptr(GtkAccessible) owner = fl_semantics_generation_ref_owner(self);
+  if (owner == nullptr) {
+    return FALSE;
+  }
+  GtkWidget* widget = gtk_accessible_get_widget(owner);
+  if (widget == nullptr || !gtk_widget_get_realized(widget) ||
+      !gtk_widget_get_mapped(widget) || !gtk_widget_is_drawable(widget)) {
+    return FALSE;
+  }
+  g_autoptr(GtkWidget) widget_owner = GTK_WIDGET(g_object_ref(widget));
+  GtkWidget* toplevel = gtk_widget_get_toplevel(widget);
+  if (!gtk_widget_is_toplevel(toplevel) ||
+      !gtk_widget_get_realized(toplevel)) {
+    return FALSE;
+  }
+  gint x = 0, y = 0;
+  if (coord_type == ATK_XY_PARENT) {
+    GtkWidget* parent = gtk_widget_get_parent(widget);
+    if (parent == nullptr ||
+        !gtk_widget_translate_coordinates(widget, parent, 0, 0, &x, &y)) {
+      return FALSE;
+    }
+  } else if (coord_type == ATK_XY_WINDOW || coord_type == ATK_XY_SCREEN) {
+    if (!gtk_widget_translate_coordinates(widget, toplevel, 0, 0, &x, &y)) {
+      return FALSE;
+    }
+    if (coord_type == ATK_XY_SCREEN) {
+      // Wayland has no global surface coordinates; its synthetic origin is not
+      // screen geometry. WINDOW and PARENT remain supported on that backend.
+#ifdef GDK_WINDOWING_X11
+      if (!GDK_IS_X11_DISPLAY(gtk_widget_get_display(widget))) {
+        return FALSE;
+      }
+#else
+      return FALSE;
+#endif
+      GdkWindow* window = gtk_widget_get_window(toplevel);
+      if (window == nullptr || gdk_window_is_destroyed(window)) {
+        return FALSE;
+      }
+      gint origin_x = 0, origin_y = 0;
+      // GDK documents the return value as meaningless.
+      gdk_window_get_origin(window, &origin_x, &origin_y);
+      gint64 screen_x = static_cast<gint64>(x) + origin_x;
+      gint64 screen_y = static_cast<gint64>(y) + origin_y;
+      if (screen_x < G_MININT || screen_x > G_MAXINT ||
+          screen_y < G_MININT || screen_y > G_MAXINT) {
+        return FALSE;
+      }
+      x = static_cast<gint>(screen_x);
+      y = static_cast<gint>(screen_y);
+    }
+  } else {
+    return FALSE;
+  }
+  GtkAllocation allocation;
+  gtk_widget_get_allocation(widget, &allocation);
+  gint scale = gtk_widget_get_scale_factor(widget);
+  if (allocation.width < 0 || allocation.height < 0 || scale <= 0 ||
+      static_cast<gint64>(x) + allocation.width > G_MAXINT ||
+      static_cast<gint64>(y) + allocation.height > G_MAXINT ||
+      !fl_semantics_generation_is_active(self)) {
+    return FALSE;
+  }
+  *geometry = {x, y, allocation.width, allocation.height, scale};
+  return TRUE;
+}
+
+gboolean fl_semantics_generation_perform_action(
+    FlSemanticsGeneration* self,
+    int32_t node_id,
+    FlutterSemanticsAction action,
+    GBytes* data) {
+  g_return_val_if_fail(FL_IS_SEMANTICS_GENERATION(self), FALSE);
+  if (!fl_semantics_generation_is_active(self)) {
+    return FALSE;
+  }
+  g_autoptr(FlEngine) engine = FL_ENGINE(g_weak_ref_get(&self->engine));
+  if (engine == nullptr || !fl_semantics_generation_is_active(self)) {
+    return FALSE;
+  }
+  fl_engine_dispatch_semantics_action(engine, self->view_id, node_id, action,
+                                      data);
+  return TRUE;
+}
