+static AtkObject* fl_accessible_node_ref_accessible_at_point(
+    AtkComponent* component, gint x, gint y, AtkCoordType coord_type) {
+  if (!fl_accessible_node_contains(component, x, y, coord_type)) {
+    return nullptr;
