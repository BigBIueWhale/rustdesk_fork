new file mode 100644
--- /dev/null
+++ b/engine/src/flutter/shell/platform/linux/fl_semantics_generation.cc
@@ -0,0 +1,83 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/linux/fl_semantics_generation.h"
+#include "flutter/shell/platform/linux/fl_engine_private.h"
+
+struct _FlSemanticsGeneration {
+  GObject parent_instance;
+
+  GWeakRef engine;
+  FlutterViewId view_id;
+  gboolean retired;
+};
+
+G_DEFINE_TYPE(FlSemanticsGeneration, fl_semantics_generation, G_TYPE_OBJECT)
+
+static void fl_semantics_generation_dispose(GObject* object) {
+  fl_semantics_generation_retire(FL_SEMANTICS_GENERATION(object));
+  G_OBJECT_CLASS(fl_semantics_generation_parent_class)->dispose(object);
+}
+
+static void fl_semantics_generation_finalize(GObject* object) {
+  FlSemanticsGeneration* self = FL_SEMANTICS_GENERATION(object);
+  g_weak_ref_clear(&self->engine);
+  G_OBJECT_CLASS(fl_semantics_generation_parent_class)->finalize(object);
+}
+
+static void fl_semantics_generation_class_init(
+    FlSemanticsGenerationClass* klass) {
+  G_OBJECT_CLASS(klass)->dispose = fl_semantics_generation_dispose;
+  G_OBJECT_CLASS(klass)->finalize = fl_semantics_generation_finalize;
+}
+
+static void fl_semantics_generation_init(FlSemanticsGeneration* self) {
+  g_weak_ref_init(&self->engine, nullptr);
+  self->retired = TRUE;
+}
+
+FlSemanticsGeneration* fl_semantics_generation_new(FlEngine* engine,
+                                                   FlutterViewId view_id) {
+  g_return_val_if_fail(FL_IS_ENGINE(engine), nullptr);
+  g_return_val_if_fail(view_id >= 0, nullptr);
+  FlSemanticsGeneration* self = FL_SEMANTICS_GENERATION(
+      g_object_new(fl_semantics_generation_get_type(), nullptr));
+  g_weak_ref_set(&self->engine, engine);
+  self->view_id = view_id;
+  self->retired = FALSE;
+  return self;
+}
+
+void fl_semantics_generation_retire(FlSemanticsGeneration* self) {
+  g_return_if_fail(FL_IS_SEMANTICS_GENERATION(self));
+  self->retired = TRUE;
+  g_weak_ref_set(&self->engine, nullptr);
+}
+
+gboolean fl_semantics_generation_is_active(FlSemanticsGeneration* self) {
+  g_return_val_if_fail(FL_IS_SEMANTICS_GENERATION(self), FALSE);
+  if (self->retired) {
+    return FALSE;
+  }
+  g_autoptr(FlEngine) engine = FL_ENGINE(g_weak_ref_get(&self->engine));
+  return engine != nullptr;
+}
+
+gboolean fl_semantics_generation_perform_action(
+    FlSemanticsGeneration* self,
+    int32_t node_id,
+    FlutterSemanticsAction action,
+    GBytes* data) {
+  g_return_val_if_fail(FL_IS_SEMANTICS_GENERATION(self), FALSE);
+  if (self->retired) {
+    return FALSE;
+  }
+  g_autoptr(FlEngine) engine = FL_ENGINE(g_weak_ref_get(&self->engine));
+  if (engine == nullptr || self->retired) {
+    return FALSE;
+  }
+  fl_engine_dispatch_semantics_action(engine, self->view_id, node_id, action,
+                                      data);
+  return TRUE;
+}
