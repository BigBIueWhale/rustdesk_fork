+struct SemanticsMatrix {
+  double values[3][3];
+};
+
+static SemanticsMatrix semantics_matrix(const FlutterTransformation& transform) {
+  return {{{transform.scaleX, transform.skewX, transform.transX},
+           {transform.skewY, transform.scaleY, transform.transY},
+           {transform.pers0, transform.pers1, transform.pers2}}};
+}
+
+static gboolean multiply_matrix(const SemanticsMatrix& parent,
+                                 const SemanticsMatrix& local,
+                                 SemanticsMatrix* result) {
+  *result = {};
+  for (guint row = 0; row < 3; row++) {
+    for (guint column = 0; column < 3; column++) {
+      for (guint k = 0; k < 3; k++) {
+        result->values[row][column] += parent.values[row][k] * local.values[k][column];
+      }
+      if (!std::isfinite(result->values[row][column])) {
+        return FALSE;
+      }
+    }
+  }
+  return TRUE;
+}
+
+static gboolean transform_rect(const FlutterRect& rect,
+                                const SemanticsMatrix& matrix,
+                                FlutterRect* bounds) {
+  if (!std::isfinite(rect.left) || !std::isfinite(rect.top) ||
+      !std::isfinite(rect.right) || !std::isfinite(rect.bottom) ||
+      rect.right < rect.left || rect.bottom < rect.top) {
+    return FALSE;
+  }
+  const auto& m = matrix.values;
+  double determinant =
+      m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) -
+      m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) +
+      m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0]);
+  if (!std::isfinite(determinant) || determinant == 0) {
+    return FALSE;
+  }
+  double sign = 0;
+  for (guint i = 0; i < 4; i++) {
+    double x = (i & 1) ? rect.right : rect.left;
+    double y = (i & 2) ? rect.bottom : rect.top;
+    double w = m[2][0] * x + m[2][1] * y + m[2][2];
+    if (!std::isfinite(w) || w == 0 || (i != 0 && std::signbit(w) != std::signbit(sign))) {
+      // A projective horizon crossing the rect has no finite bounding box.
+      return FALSE;
+    }
+    sign = w;
+    double projected_x = (m[0][0] * x + m[0][1] * y + m[0][2]) / w;
+    double projected_y = (m[1][0] * x + m[1][1] * y + m[1][2]) / w;
+    if (!std::isfinite(projected_x) || !std::isfinite(projected_y)) {
+      return FALSE;
+    }
+    if (i == 0) {
+      *bounds = {projected_x, projected_y, projected_x, projected_y};
+    } else {
+      bounds->left = MIN(bounds->left, projected_x);
+      bounds->top = MIN(bounds->top, projected_y);
+      bounds->right = MAX(bounds->right, projected_x);
+      bounds->bottom = MAX(bounds->bottom, projected_y);
+    }
+  }
+  return TRUE;
+}
+
+static gboolean round_bounds(const FlutterRect& bounds, gint scale,
+                              gint* result) {
+  double left = std::floor(bounds.left / scale);
+  double top = std::floor(bounds.top / scale);
+  double right = std::ceil(bounds.right / scale);
+  double bottom = std::ceil(bounds.bottom / scale);
+  if (left < G_MININT || left > G_MAXINT || top < G_MININT || top > G_MAXINT ||
+      right < G_MININT || right > G_MAXINT || bottom < G_MININT || bottom > G_MAXINT ||
+      right - left > G_MAXINT || bottom - top > G_MAXINT) {
+    return FALSE;
+  }
+  result[0] = static_cast<gint>(left);
+  result[1] = static_cast<gint>(top);
+  result[2] = static_cast<gint>(right - left);
+  result[3] = static_cast<gint>(bottom - top);
+  return TRUE;
+}
