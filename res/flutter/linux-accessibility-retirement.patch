+static gboolean fl_accessible_node_contains(AtkComponent* component,
+                                           gint x, gint y,
+                                           AtkCoordType coord_type) {
+  gint bounds[4];
+  return get_node_geometry(FL_ACCESSIBLE_NODE(component), coord_type, bounds) &&
+         bounds[2] > 0 && bounds[3] > 0 &&
+         static_cast<gint64>(x) >= bounds[0] && static_cast<gint64>(y) >= bounds[1] &&
+         static_cast<gint64>(x) < static_cast<gint64>(bounds[0]) + bounds[2] &&
+         static_cast<gint64>(y) < static_cast<gint64>(bounds[1]) + bounds[3];
+}
