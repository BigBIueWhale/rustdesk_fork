+// Retire GTK resources on their owning thread, before the GDK window is lost.
+// The compositor itself outlives unrealize/dispose for pending raster work.
+static void release_render_context(FlViewRenderer* self) {
+  if (self->render_context == nullptr) {
+    return;
+  }
+  gdk_gl_context_make_current(self->render_context);
+  if (FL_IS_COMPOSITOR_OPENGL(self->compositor)) {
+    fl_compositor_opengl_release_render_texture(
+        FL_COMPOSITOR_OPENGL(self->compositor));
+  }
+  gdk_gl_context_clear_current();
+  g_clear_object(&self->render_context);
+}
+
+// Implements GtkWidget::unrealize.
+static void fl_view_renderer_unrealize(GtkWidget* widget) {
+  release_render_context(FL_VIEW_RENDERER(widget));
+  GTK_WIDGET_CLASS(fl_view_renderer_parent_class)->unrealize(widget);
+}
