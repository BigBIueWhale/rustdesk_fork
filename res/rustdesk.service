[Unit]
Description=RustDesk (hardened fork — headless controlled-only direct-IP service, §17)
Requires=network.target
After=systemd-user-sessions.service network.target
# Keep failure recovery available after repeated supervisor exits.
# StartLimitIntervalSec=0 disables start-rate lockout. RestartSec spaces
# successive retries; an explicit stop does not request automatic recovery.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/rustdesk --service
# The supervisor drains admitted IPC before retiring its exact child. Only it
# receives the initial stop signal; the whole cgroup remains the kill backstop.
KillMode=mixed
TimeoutStopSec=30
User=root
# The portable supervisor protocol owns this directory on every init system.
# systemd creates the same root-only shape and preserves crash evidence across
# automatic restarts; a clean stop may remove it after the supervisor exits.
RuntimeDirectory=rustdesk
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
# R-T1: launcher limits supplement in-process fd/session and pre-key bounds.
# Percentage memory ceilings supplement finite application admission.
# Failure recovery may repeat while failures persist; a deliberate stop stays stopped.
LimitNOFILE=8192
TasksMax=512
MemoryAccounting=yes
MemoryHigh=50%
MemoryMax=65%
Restart=on-failure
RestartSec=2
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

# ── R-D3a: systemd confinement the upstream unit lacked ───────────────────────
# The service MUST run as root — input injection, virtual display, login-screen
# capture, and the native credential drop to the --server child all need it (R-D3). So
# NoNewPrivileges is DELIBERATELY NOT set (it would break that drop). The §8
# excisions remove the reachable escalation paths; these directives shrink the
# blast radius of anything missed, each compatible with the root + capture reality.
#
# Drop capabilities the service never uses (the spec's named set + obvious peers).
# CAP_SYS_PTRACE is intentionally retained: the root supervisor revalidates the exact
# executable object and launch environment of its non-root child through protected procfs.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_RAWIO CAP_NET_ADMIN CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE CAP_MAC_ADMIN CAP_MAC_OVERRIDE
# v4-only at the kernel-policy layer — the twin of R-D5's v4-only bind. Keep
# AF_UNIX (local IPC) and AF_INET (the one direct port, 21118); drop AF_INET6 and
# AF_NETLINK.
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# @system-service plus mount/umount for the authenticated owner's root terminal.
# Linux file clipboard uses fixed-path fusermount fd passing, not RustDesk mount(2).
# Keep reboot/swap and the broader @mount namespace/root-changing set out.
SystemCallFilter=@system-service mount umount umount2 pidfd_open pidfd_send_signal renameat2
SystemCallFilter=~@reboot @swap

[Install]
WantedBy=multi-user.target
