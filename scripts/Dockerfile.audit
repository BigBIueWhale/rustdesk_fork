# scripts/Dockerfile.audit — the R-R3 / R-A7 dependency-advisory gate image.
#
# Bakes cargo-audit, cargo-deny, and the RustSec advisory-db pinned at a recorded
# commit. The advisory-db pin is load-bearing (R-B10/R-B12 provenance): the audit
# result is reproducible only against a fixed snapshot, and cargo-audit 0.21.1
# cannot parse newer advisory-db schema entries.
ARG RUST_VERSION=1.75
ARG BASE_DIGEST
FROM rust:${RUST_VERSION}-slim@${BASE_DIGEST}

ARG CARGO_AUDIT_VERSION=0.21.1
ARG CARGO_DENY_VERSION=0.14.24
ARG ADVISORY_DB_SHA=4ea955aed4d1b1214badc01f9d029bb12ef9e8e4

# git for the advisory-db clone; cargo-audit needs no extra native deps.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# The pinned Rust advisory tools that build on the pinned Rust toolchain.
RUN cargo install cargo-audit --version "$CARGO_AUDIT_VERSION" --locked \
    && cargo install cargo-deny --version "$CARGO_DENY_VERSION" --locked

# Pinned advisory-db snapshot (2025-11-30; pre-2026 so 0.21.1 can parse it).
# Bump deliberately (and re-review the deny.toml accepts) — never silently.
ENV ADVISORY_DB=/opt/advisory-db
ENV CARGO_DENY_DB_PATH=/opt/cargo-deny-advisory-dbs
ENV CARGO_DENY_DB_DIR=github.com-a946fc29ac602819
RUN git clone https://github.com/RustSec/advisory-db /opt/advisory-db \
    && git -C /opt/advisory-db checkout -q "$ADVISORY_DB_SHA" \
    && mkdir -p "$CARGO_DENY_DB_PATH" \
    && ln -s "$ADVISORY_DB" "$CARGO_DENY_DB_PATH/$CARGO_DENY_DB_DIR"
