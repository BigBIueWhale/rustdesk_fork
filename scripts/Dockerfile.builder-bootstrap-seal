# Seal one package-discovery image as a reviewable bootstrap candidate.
#
# This Dockerfile is consumed through stdin with no filesystem context.  It
# must remain metadata-only: the acquisition image already contains the
# canonical package manifest and its self-derived contract.
ARG BOOTSTRAP_IMAGE_HANDLE
FROM ${BOOTSTRAP_IMAGE_HANDLE}
ARG DPKG_MANIFEST_SHA256
LABEL org.rustdesk.build-input.dpkg-manifest-sha256="${DPKG_MANIFEST_SHA256}"
