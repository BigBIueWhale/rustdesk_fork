# scripts/Dockerfile.dart-audit — the DART half of the R-R3 dependency-advisory gate.
#
# The Rust half is scripts/Dockerfile.audit (cargo-audit + a pinned RustSec
# advisory-db). This is its mirror for the resolved Pub/Dart dependency graph
# (flutter/pubspec.lock): it bakes Google's OSV-Scanner at a PINNED version plus
# a PINNED snapshot of the OSV "Pub" advisory database, so scripts/dart-audit.sh
# can run the scan --offline — it never queries the live OSV API at run time, and
# the verdict is reproducible against a fixed snapshot (R-B10/R-B12 provenance),
# exactly like the cargo-audit twin against ADVISORY_DB_COMMIT.
#
# Two pins are load-bearing and verified before this build (fail-closed on drift):
#   * the osv-scanner binary  -> OSV_SCANNER_SHA256  (pins.env)
#   * the OSV Pub db snapshot  -> OSV_DB_PUB_SHA256  (pins.env)
# scripts/online-fetch.sh acquires those standalone files by exact URL, size, and
# SHA-256 through its no-clobber fixed-archive transaction, validates their
# publisher checksums and database structure, then invokes this Dockerfile with
# --network=none and --pull=false. scripts/dart-audit.sh never invokes any of
# that maintenance authority. The resulting image is independently archived,
# and verdict execution needs no network or mutable tag.
#
# FROM the already-local digest-pinned ubuntu:18.04 baseline (the same
# SHA256_BASEIMAGE_UBUNTU_1804 provenance used by the .deb builder). osv-scanner
# is a static Go binary, so no package installation or network operation exists.
ARG BASE_DIGEST=sha256:152dc042452c496007f07ca9127571cb9c29697f42acbfad72324b2bb2e43c98
FROM ubuntu:18.04@${BASE_DIGEST} AS validated-inputs

ARG OSV_SCANNER_VERSION
ARG OSV_SCANNER_SHA256
ARG OSV_DB_PUB_SHA256
ARG OSV_DB_PUB_SIZE
ARG OSV_DB_PUB_CAPTURE_EPOCH

USER 65532:65532
COPY --chown=65532:65532 --chmod=0755 osv-scanner /inputs/osv-scanner
COPY --chown=65532:65532 --chmod=0644 Pub-all.zip /inputs/all.zip

RUN set -eu; \
    printf '%s  %s\n' "${OSV_SCANNER_SHA256}" /inputs/osv-scanner \
      | sha256sum --check --strict --status -; \
    printf '%s  %s\n' "${OSV_DB_PUB_SHA256}" /inputs/all.zip \
      | sha256sum --check --strict --status -; \
    [ "$(stat -c '%s' /inputs/all.zip)" = "${OSV_DB_PUB_SIZE}" ]; \
    touch -d "@${OSV_DB_PUB_CAPTURE_EPOCH}" /inputs/all.zip; \
    [ "$(stat -c '%Y' /inputs/all.zip)" = "${OSV_DB_PUB_CAPTURE_EPOCH}" ]; \
    /inputs/osv-scanner --version

FROM ubuntu:18.04@${BASE_DIGEST}

ARG BASE_DIGEST
ARG OSV_SCANNER_VERSION
ARG OSV_SCANNER_SHA256
ARG OSV_DB_PUB_SHA256
ARG OSV_DB_PUB_SIZE
ARG OSV_DB_PUB_CAPTURE_EPOCH
ARG OSV_DB_PUB_GENERATION
ARG DART_AUDIT_DOCKERFILE_SHA256
ARG DART_AUDIT_CONTRACT=rustdesk-dart-audit-image-v1

ENV OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=/opt/osv-db

LABEL org.rustdesk.dart-audit-input.contract="${DART_AUDIT_CONTRACT}" \
      org.rustdesk.dart-audit-input.base="ubuntu:18.04@${BASE_DIGEST}" \
      org.rustdesk.dart-audit-input.dockerfile-sha256="${DART_AUDIT_DOCKERFILE_SHA256}" \
      org.rustdesk.dart-audit-input.scanner-version="${OSV_SCANNER_VERSION}" \
      org.rustdesk.dart-audit-input.scanner-sha256="${OSV_SCANNER_SHA256}" \
      org.rustdesk.dart-audit-input.database-sha256="${OSV_DB_PUB_SHA256}" \
      org.rustdesk.dart-audit-input.database-size="${OSV_DB_PUB_SIZE}" \
      org.rustdesk.dart-audit-input.database-capture-epoch="${OSV_DB_PUB_CAPTURE_EPOCH}" \
      org.rustdesk.dart-audit-input.database-generation="${OSV_DB_PUB_GENERATION}"

COPY --from=validated-inputs --chown=0:0 --chmod=0755 \
    /inputs/osv-scanner /usr/local/bin/osv-scanner
# BuildKit applies COPY --chmod to the first missing destination component.
# Establish traversable database parents with the exact same bytes first, then
# replace only the final file at its required read-only runtime mode.
COPY --from=validated-inputs --chown=0:0 --chmod=0755 \
    /inputs/all.zip /opt/osv-db/osv-scanner/Pub/all.zip
COPY --from=validated-inputs --chown=0:0 --chmod=0644 \
    /inputs/all.zip /opt/osv-db/osv-scanner/Pub/all.zip
