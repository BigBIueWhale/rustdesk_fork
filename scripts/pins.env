# scripts/pins.env — the single source of truth for every version the build fixes.
#
# Machine-readable form of requirements.html §3.2 (R-B5a, R-B10, R-R1). A
# shell-sourceable KEY=value manifest: no build script may resolve "latest" or a
# moving channel — every version comes from here (R-B9). Each value below is read
# from the pinned tree (rustdesk 0c86d46 / hbb_common df6badc) at its cited
# location and re-verified against the repo.
#
# Two kinds of pin live here:
#   1. VERSIONS / git SHA-1 commit pins — fixed below (verified in-tree).
#   2. SHA-256/SHA512 artifact digests for ./online (R-B10/R-B12) — every fetched
#      toolchain, SDK, image, installer and captured distfile that the build flow
#      consumes is pinned below with per-pin provenance. The SHA_PENDING sentinel
#      remains available for future/operator-only entries, and online-fetch.sh
#      MUST treat any sentinel it is asked to consume as a hard fail-closed error:
#      never fetch-and-trust, never fabricate a first pin.
SHA_PENDING="__PENDING_R_B12__"

# ── Source pins (git SHA-1; the only content anchor for git deps, R-B12) ──────
RUSTDESK_COMMIT="0c86d4616298f09435f6236599b300964aa61460"   # tag 1.4.7
HBB_COMMON_COMMIT="df6badca5bf81b4e9836256cf8e31c993ad70dd1" # absorbed in-tree (libs/hbb_common)
VCPKG_BASELINE="120deac3062162151622ca4860575a33844ba10b"    # vcpkg.json default-registry baseline (registry snapshot 2025.08.27)
ADVISORY_DB_COMMIT="b5fc89b8be99e96f79194d8a6f11e9b4143b99f0" # RustSec advisory-db snapshot 2026-07-17, independently fetched by exact commit and reviewed against Cargo.lock/deny.toml on 2026-07-22.
ADVISORY_DB_COMMIT_EPOCH="1784303558" # Exact Git committer epoch of ADVISORY_DB_COMMIT (2026-07-17T15:52:38Z); rechecked inside the immutable image.
ADVISORY_DB_MAX_AGE_DAYS="90" # Fail closed at release. --no-fetch deliberately suppresses scanner acquisition, so scripts/audit.sh owns this freshness bound explicitly.
CARGO_AUDIT_TAG_OBJECT="78bd4d48923d207898e94827cbd79d73903a85fa" # Official RustSec cargo-audit/v0.22.2 annotated tag object, independently fetched 2026-07-25.
CARGO_AUDIT_SOURCE_COMMIT="281452c35cf0870969042374110f099a411bc185" # Exact commit named by CARGO_AUDIT_TAG_OBJECT.
CARGO_AUDIT_SOURCE_TREE="62833baf6c7ae4ac676f00bb52687e62cd5bed4c" # Exact Git tree compiled for cargo-audit and its RustSec workspace siblings.
SHA256_CARGO_AUDIT_SOURCE_ARCHIVE="457562cec67c15aebd76da04d0e7a632efb82d1425d973cbd4c67f6c5ca18044" # Canonical `git archive --format=tar` of CARGO_AUDIT_SOURCE_COMMIT.
CARGO_AUDIT_SIGNING_KEY_FINGERPRINT="SHA256:Nek/oTQkBpjde4wx0GVl9zJkmMae8M65edoqmLdafUE" # Dirkjan Ochtman's SSH key on the signed cargo-audit/v0.22.2 tag; independently matched against github.com/djc.keys.
CARGO_DENY_TAG_OBJECT="87da103c554376c89a641116f835a41073a9d774" # Official EmbarkStudios 0.20.2 annotated tag object, independently fetched 2026-07-25; upstream publishes this tag unsigned.
CARGO_DENY_SOURCE_COMMIT="bca0dde53651ee946720e4540b5ce2610bec8f06" # Exact commit named by CARGO_DENY_TAG_OBJECT.
CARGO_DENY_SOURCE_TREE="fbfc96f028b5f197ca062ddce1301395578feded" # Exact Git tree compiled for cargo-deny.
SHA256_CARGO_DENY_SOURCE_ARCHIVE="3a719d0cf4785e646a39fbf97fbdc75ab832c7eafde91ba3d56d16d410ce6bc9" # Canonical `git archive --format=tar` of CARGO_DENY_SOURCE_COMMIT; independent SHA-256 trust anchor for the unsigned upstream tag.

# ── Reproducible-build epoch (R-B2) ───────────────────────────────────────────
# SOURCE_DATE_EPOCH is pinned to a FIXED constant (deliberately NOT a git commit date) so the
# artifacts depend ONLY on the source tree, not on git metadata — a doc/record commit (e.g. writing
# the release SHAs into HARDENING_STATUS) does NOT change the binaries, and R-B2 A==B stays a clean
# "same tree -> same bytes". build.rs honours it. This SAME value is independently anchored by the
# Apple source-conformance gate and asserted by verify.sh — keep all consumers in sync if it is bumped.
# NOTE: the build scripts previously tried to derive this from RUSTDESK_COMMIT — the UPSTREAM 1.4.7 tag
# SHA, which is NOT in the fork's history — so `git show` always failed and it SILENTLY fell back to
# this constant every build. That dead derivation + silent fallback is removed; this is now the one
# explicit, honest pin every build reads. (Value = 2023-11-14T22:13:20Z.)
SOURCE_DATE_EPOCH_PIN="1700000000"

# ── Toolchain (R-B5a, §3.2) ───────────────────────────────────────────────────
RUST_VERSION="1.75"          # all shipped targets; rust-toolchain.toml + flutter-build.yml RUST_VERSION (edition 2021)
RUST_VERSION_MACOS="1.81"    # macOS-only, NOT a build target (R-R2); recorded for the Apple cargo-check job
RUST_AUDIT_RUST_VERSION="1.88" # independent audit-image toolchain family; does not change the shipped Rust 1.75 compiler
RUST_AUDIT_RUSTC_VERSION="1.88.0" # exact compiler version verified inside the immutable audit image
RUST_AUDIT_TOOLCHAIN="1.88.0-x86_64-unknown-linux-gnu" # no rustup channel resolution during the networkless verdict
FLUTTER_VERSION="3.24.5"     # FLUTTER_VERSION / ANDROID_FLUTTER_VERSION
LLVM_VERSION="15.0.6"        # LLVM_VERSION (bindgen libclang determinism, R-B12)
PYTHON_VERSION="3.11.9"      # PYTHON_VERSION (build.py orchestrator + libs/portable/generate.py brotli, §12.2 win)
OLEFILE_VERSION="0.47"        # canonicalize-msi.py; pure-Python wheel staged for the offline Windows build
ANDROID_NDK_VERSION="r28c"   # NDK_VERSION (SDK pkg ndk;28.2.13676358)
CARGO_NDK_VERSION="3.1.2"    # CARGO_NDK_VERSION (MSRV 1.68 — builds on 1.75)
CARGO_AUDIT_VERSION="0.22.2" # immutable audit-image tool; Rust 1.88 is isolated from the shipped Rust 1.75 compiler and parses current CVSS 4.0 RustSec records
CARGO_DENY_VERSION="0.20.2" # immutable audit-image tool, compiled from its released packaged lockfile
OSV_SCANNER_VERSION="2.4.0"  # the Dart-side R-R3 supply-chain gate (scripts/Dockerfile.dart-audit + dart-audit.sh); Google OSV-Scanner, scans flutter/pubspec.lock (Pub ecosystem)
OSV_SCALIBR_VERSION="0.4.5"   # exact component version reported by the pinned OSV-Scanner binary
OSV_SCANNER_COMMIT="b56b5191101d5f27d4787d5583d8d01e9518a7af" # exact upstream build commit reported by osv-scanner 2.4.0
OSV_SCANNER_BUILT_AT="2026-06-18T12:55:27Z" # exact upstream build timestamp reported by the pinned binary

# ── Installed-systemd lifecycle VM (R-S11c-27m) ──────────────────────────────
# Immutable Debian 12 genericcloud build used only by the networkless QEMU/KVM
# behavior gate; it is test infrastructure, not a release artifact/input and is
# cached under private .harness-state rather than the canonical ./online build
# closure. R-B12 (2026-07-24): Debian's dated publisher SHA512SUMS entry for
# debian-12-genericcloud-amd64-20260712-2537.qcow2 equals both the existing
# cached image and a complete disposable cold acquisition. SHA-256 and size
# were independently measured from those publisher-SHA512-exact bytes and bind
# the bounded acquisition transaction. The dated URL never follows `latest`.
DEBIAN_SYSTEMD_SMOKE_IMAGE_BUILD="20260712-2537"
SIZE_DEBIAN_SYSTEMD_SMOKE_IMAGE="346882048"
SHA256_DEBIAN_SYSTEMD_SMOKE_IMAGE="b49303d83f5f69ff55fdf8c16b883b5714bc5332d37a6f6b8a94da42ad5b0999"
SHA512_DEBIAN_SYSTEMD_SMOKE_IMAGE="6c2607f1846ee86040830c87d0b723f0967da3e884ea4673d9db4aa8eee13a4b7c663524bfa42082c16fc6919f3aa1bf425c004d07ff06c53a319ad0c42647bb"

# ── R-R3 advisory-DB / OSV snapshots (pinned for reproducibility, R-B10/B12) ───
# The advisory data is itself a pin: a moving DB makes the gate non-reproducible.
ADVISORY_DB_COMMIT_NOTE="see ADVISORY_DB_COMMIT in the source-pins block above (RustSec, cargo-audit twin)"
# osv-scanner_linux_amd64 v2.4.0 — the static-Go binary copied into
# Dockerfile.dart-audit from the standalone fixed-input transaction.
# R-B12 recheck (2026-07-25): the 56,676,514-byte official versioned GitHub asset
# has this SHA-256; the release's 554-byte osv-scanner_SHA256SUMS
# (SHA-256 9d6fff9bac4d77269c8b04a1b74b72cd087842106abd11d8e0426ab07b2dd441)
# lists the same digest; and the 23,923-byte Sigstore/SLSA bundle
# (SHA-256 9ef16324e97bec3b915e93acfa9ad38673333452bb28299ab7317a3c14847d0b)
# binds that subject digest to tag v2.4.0 and commit OSV_SCANNER_COMMIT. The
# fixed transaction fetches the exact asset by that versioned URL, size, and
# digest; re-pin all three publisher paths together on a version bump.
OSV_SCANNER_SIZE="56676514"
OSV_SCANNER_SHA256="15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0"
# The pinned OSV Pub-ecosystem advisory-DB snapshot (osv-vulnerabilities GCS bucket,
# Pub/all.zip; 13 advisories in this generation). Baked into the image so the gate
# runs --offline. R-B12 refresh (2026-07-25): the JSON metadata endpoint named
# generation 1783494617999513, size 19,448, updated 2026-07-08T07:10:18.106Z,
# MD5 yOWu6VS64jMQQPA8ZzScvQ==, and CRC32C W78GeA==. A second request addressed
# that exact generation through the GCS media API; the response repeated the
# generation, length, MD5, and CRC32C, while independent local calculations
# matched both publisher checksums and established the SHA-256 below. The
# bounded structural validator found exactly 13 single-file JSON records,
# 47,209 uncompressed bytes, no traversal/duplicates/case collisions, and matching
# filename/record IDs. The image mtime is the publisher update epoch, not the
# later acquisition time, so the 30-day release-freshness rule remains conservative.
OSV_DB_PUB_SHA256="5fdd3db5059b4f935a507385cb93cab3c35ba3d632332a5c8f5deb604f95a5c0"
OSV_DB_PUB_SIZE="19448"
OSV_DB_PUB_CAPTURE_EPOCH="1783494618"
OSV_DB_PUB_MAX_AGE_DAYS="30"
OSV_DB_PUB_GENERATION="1783494617999513"
OSV_DB_PUB_METAGENERATION="1"
OSV_DB_PUB_UPDATED="2026-07-08T07:10:18.106Z"
OSV_DB_PUB_MD5_BASE64="yOWu6VS64jMQQPA8ZzScvQ=="
OSV_DB_PUB_CRC32C_BASE64="W78GeA=="
OSV_DB_PUB_RECORDS="13"
OSV_DB_PUB_UNCOMPRESSED_BYTES="47209"

