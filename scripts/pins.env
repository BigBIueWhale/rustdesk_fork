# libyuv fetches from
# googlesource, whose gitiles `+archive` tarballs are EMPIRICALLY non-reproducible
# (two fetches 4s apart differ — even the decompressed tar: gitiles re-timestamps/
# reorders), so its URL cannot be SHA-pinned, and R-R1 forbids vendoring the
# source. Instead online-fetch's stage_vcpkg_distfiles writes a REPRODUCIBLE
# `git -c core.autocrlf=false archive --format=tar <commit> | gzip -n` into ./online,
# and the overlay portfile consumes it SHA512-verified (file://) — falling back to
# the git-SHA-1 commit pin on hosts without the capture. The full commit SHA-1 is the upstream
# content anchor; the SHA512 binds the exact captured bytes. CAVEAT: the archive
# bytes depend on the builder image's git (these computed in the pinned deb-builder,
# git 2.17.1) — re-pin if that image's git changes (same class as the GitHub-archive
# caveat on SHA256_VCPKG_120DEAC3 below).
LIBYUV_COMMIT="0faf8dd0e004520a61a603a4d2996d5ecc80dc3f"       # libyuv chromium pin (res/vcpkg/libyuv/portfile.cmake)
SHA512_LIBYUV="be6b343ab6c62e8f2d1571fedf25f5facbf7cd7fe8e1cc4949dab7549ad15f962c91ea43bf567785e54382d7689514f6b66d61bd56b3f38ba54ef51c5fd0da9b"

# ── Windows packaging (§3.2) ──────────────────────────────────────────────────
WIX_NUGET_VERSION="4.0.5"            # Exact WixToolset.Sdk + five extension package version
WIX_NUGET_AUTHOR_CERT_SHA256="0DB368BC1A5A9E19CC9E036B490B7C4A4D3DFB941C0781B4F22F218BE0B54986"
WIX_NUGET_REPOSITORY_CERT_SHA256="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4"

