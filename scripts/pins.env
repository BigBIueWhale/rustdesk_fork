VERIFIER_VM_ROOT_FILESYSTEM_UUID="6f245985-3707-4ae4-b564-8a39c36fba53"
SIZE_VERIFIER_VM_KERNEL="14149568"
SHA256_VERIFIER_VM_KERNEL="3d616aa853fe11b1c0ea99a1cdb4fb6ddc9010ba7c4562de700ad94264989654"
