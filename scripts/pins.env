# scripts/pins.env — the single source of truth for every version the build fixes.
#
# Machine-readable form of requirements.html §3.2 (R-B5a, R-B10, R-R1). A
# shell-sourceable KEY=value manifest: no build script may resolve "latest" or a
# moving channel — every version comes from here (R-B9). Each value below is read
# from the pinned tree (rustdesk 0c86d46 / hbb_common df6badc) at its cited
# location and re-verified against the repo.
#
# Two kinds of pin live here:
#   1. VERSIONS / git SHA-1 commit pins — fixed below (verified in-tree).
#   2. SHA-256/SHA512 artifact digests for ./online (R-B10/R-B12) — every fetched
#      toolchain, SDK, image, installer and captured distfile that the build flow
#      consumes is pinned below with per-pin provenance. The SHA_PENDING sentinel
#      remains available for future/operator-only entries, and online-fetch.sh
#      MUST treat any sentinel it is asked to consume as a hard fail-closed error:
#      never fetch-and-trust, never fabricate a first pin.
SHA_PENDING="__PENDING_R_B12__"

# ── Source pins (git SHA-1; the only content anchor for git deps, R-B12) ──────
RUSTDESK_COMMIT="0c86d4616298f09435f6236599b300964aa61460"   # tag 1.4.7
HBB_COMMON_COMMIT="df6badca5bf81b4e9836256cf8e31c993ad70dd1" # absorbed in-tree (libs/hbb_common)
VCPKG_BASELINE="120deac3062162151622ca4860575a33844ba10b"    # vcpkg.json default-registry baseline (registry snapshot 2025.08.27)
ADVISORY_DB_COMMIT="b5fc89b8be99e96f79194d8a6f11e9b4143b99f0" # RustSec advisory-db snapshot 2026-07-17, independently fetched by exact commit and reviewed against Cargo.lock/deny.toml on 2026-07-22.
ADVISORY_DB_COMMIT_EPOCH="1784303558" # Exact Git committer epoch of ADVISORY_DB_COMMIT (2026-07-17T15:52:38Z); rechecked inside the immutable image.
ADVISORY_DB_MAX_AGE_DAYS="90" # Fail closed at release. --no-fetch deliberately suppresses scanner acquisition, so scripts/audit.sh owns this freshness bound explicitly.

# ── Reproducible-build epoch (R-B2) ───────────────────────────────────────────
# SOURCE_DATE_EPOCH is pinned to a FIXED constant (deliberately NOT a git commit date) so the
# artifacts depend ONLY on the source tree, not on git metadata — a doc/record commit (e.g. writing
# the release SHAs into HARDENING_STATUS) does NOT change the binaries, and R-B2 A==B stays a clean
# "same tree -> same bytes". build.rs honours it. This SAME value is independently anchored by the
# Apple source-conformance gate and asserted by verify.sh — keep all consumers in sync if it is bumped.
# NOTE: the build scripts previously tried to derive this from RUSTDESK_COMMIT — the UPSTREAM 1.4.7 tag
# SHA, which is NOT in the fork's history — so `git show` always failed and it SILENTLY fell back to
# this constant every build. That dead derivation + silent fallback is removed; this is now the one
# explicit, honest pin every build reads. (Value = 2023-11-14T22:13:20Z.)
SOURCE_DATE_EPOCH_PIN="1700000000"

# ── Toolchain (R-B5a, §3.2) ───────────────────────────────────────────────────
RUST_VERSION="1.75"          # all shipped targets; rust-toolchain.toml + flutter-build.yml RUST_VERSION (edition 2021)
RUST_VERSION_MACOS="1.81"    # macOS-only, NOT a build target (R-R2); recorded for the Apple cargo-check job
RUST_AUDIT_RUST_VERSION="1.88" # independent audit-image toolchain family; does not change the shipped Rust 1.75 compiler
RUST_AUDIT_RUSTC_VERSION="1.88.0" # exact compiler version verified inside the immutable audit image
RUST_AUDIT_TOOLCHAIN="1.88.0-x86_64-unknown-linux-gnu" # no rustup channel resolution during the networkless verdict
FLUTTER_VERSION="3.24.5"     # FLUTTER_VERSION / ANDROID_FLUTTER_VERSION
LLVM_VERSION="15.0.6"        # LLVM_VERSION (bindgen libclang determinism, R-B12)
PYTHON_VERSION="3.11.9"      # PYTHON_VERSION (build.py orchestrator + libs/portable/generate.py brotli, §12.2 win)
OLEFILE_VERSION="0.47"        # canonicalize-msi.py; pure-Python wheel staged for the offline Windows build
ANDROID_NDK_VERSION="r28c"   # NDK_VERSION (SDK pkg ndk;28.2.13676358)
CARGO_NDK_VERSION="3.1.2"    # CARGO_NDK_VERSION (MSRV 1.68 — builds on 1.75)
CARGO_AUDIT_VERSION="0.22.2" # immutable audit-image tool; Rust 1.88 is isolated from the shipped Rust 1.75 compiler and parses current CVSS 4.0 RustSec records
CARGO_DENY_VERSION="0.20.2" # immutable audit-image tool, compiled from its released packaged lockfile
OSV_SCANNER_VERSION="2.4.0"  # the Dart-side R-R3 supply-chain gate (scripts/Dockerfile.dart-audit + dart-audit.sh); Google OSV-Scanner, scans flutter/pubspec.lock (Pub ecosystem)
OSV_SCALIBR_VERSION="0.4.5"   # exact component version reported by the pinned OSV-Scanner binary
OSV_SCANNER_COMMIT="b56b5191101d5f27d4787d5583d8d01e9518a7af" # exact upstream build commit reported by osv-scanner 2.4.0
OSV_SCANNER_BUILT_AT="2026-06-18T12:55:27Z" # exact upstream build timestamp reported by the pinned binary

# ── Installed-systemd lifecycle VM (R-S11c-27m) ──────────────────────────────
# Immutable Debian 12 genericcloud build used only by the networkless QEMU/KVM
# behavior gate; it is test infrastructure, not a release artifact/input and is
# cached under private .harness-state rather than the canonical ./online build
# closure. R-B12 (2026-07-17): Debian's dated publisher SHA512SUMS entry for
# debian-12-genericcloud-amd64-20260712-2537.qcow2 equals an independent local
# download-and-compute. The dated URL never follows the moving `latest` alias.
DEBIAN_SYSTEMD_SMOKE_IMAGE_BUILD="20260712-2537"
SHA512_DEBIAN_SYSTEMD_SMOKE_IMAGE="6c2607f1846ee86040830c87d0b723f0967da3e884ea4673d9db4aa8eee13a4b7c663524bfa42082c16fc6919f3aa1bf425c004d07ff06c53a319ad0c42647bb"

# ── R-R3 advisory-DB / OSV snapshots (pinned for reproducibility, R-B10/B12) ───
# The advisory data is itself a pin: a moving DB makes the gate non-reproducible.
ADVISORY_DB_COMMIT_NOTE="see ADVISORY_DB_COMMIT in the source-pins block above (RustSec, cargo-audit twin)"
# osv-scanner_linux_amd64 v2.4.0 — the static-Go binary baked into Dockerfile.dart-audit.
# R-B12 (2026-06-25): SHA-256 download-computed from the official github release asset
# (github.com/google/osv-scanner releases/download/v2.4.0/osv-scanner_linux_amd64) ==
# the digest recorded for that subject in the release's SLSA provenance attestation
# (multiple.intoto.jsonl, slsa.dev/provenance/v0.2) — publisher attestation + byte
# integrity, two paths. Re-pin from the same two paths on any version bump.
OSV_SCANNER_SHA256="15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0"
# The pinned OSV Pub-ecosystem advisory-DB snapshot (osv-vulnerabilities GCS bucket,
# Pub/all.zip; 13 advisories at capture). Baked into the image so the gate runs
# --offline (never queries the live OSV API at run time) — the deterministic analogue
# of ADVISORY_DB_COMMIT for the Dart side. R-B12 (2026-06-25): SHA-256 download-computed
# from https://osv-vulnerabilities.storage.googleapis.com/Pub/all.zip (last-modified
# 2026-06-02). The immutable image records the download/capture mtime as
# 2026-06-25T00:33:19Z; the release gate checks that exact metadata and allows at
# most 30 days from capture. Bump deliberately (and re-review
# dart-audit-ignores.txt) — never silently.
OSV_DB_PUB_SHA256="8b1d25767804f7487d7a26d9ae001c00813329252157eb7d267a8fb6f575b87c"
OSV_DB_PUB_SIZE="19437"
OSV_DB_PUB_CAPTURE_EPOCH="1782347599"
OSV_DB_PUB_MAX_AGE_DAYS="30"

# ── Flutter / Android build host (§3.2) ───────────────────────────────────────
ANDROID_AGP_VERSION="7.3.1"          # flutter/android/settings.gradle (com.android.application)
ANDROID_KOTLIN_VERSION="2.1.21"      # flutter/android/settings.gradle (kotlin.android)
ANDROID_KOTLIN_STDLIB_VERSION="1.9.10" # flutter/android/app/build.gradle (runtime stdlib dependency; distinct from the Kotlin Gradle plugin/compiler pin above)
ANDROID_GRADLE_WRAPPER="7.6.4"       # flutter/android/gradle/wrapper/gradle-wrapper.properties
SHA256_ANDROID_GRADLE_WRAPPER_ALL="fe696c020f241a5f69c30f763c5a7f38eec54b490db19cd2b0962dda420d7d12" # Publisher-listed Gradle 7.6.4 complete (-all) distribution checksum.
ANDROID_JDK_VERSION="17"             # CI JAVA_HOME (android job)
ANDROID_COMPILE_SDK="34"             # flutter/android/app/build.gradle compileSdkVersion
ANDROID_BUILD_TOOLS="34.0.0"         # build-tools (§3.2)
ANDROID_TARGET_SDK="33"              # targetSdkVersion
ANDROID_MIN_SDK="24"                 # minSdkVersion
ANDROID_NDK_API="21"                 # flutter/ndk_arm64.sh
ANDROID_CMDLINE_TOOLS_BUILD="15641748" # cmdline-tools;latest rev 21 versioned build number (the reproducible pin; NOT the moving "...-latest.zip"); from the Android SDK repository2-1.xml
# Public certificate fingerprint of the one stable rustdesk-fork signing key; no private-key material.
ANDROID_SIGNING_CERT_SHA256="1091322BA0425AFA1EB50DEEAE439A5FFFE2B1DD82C82B04515D9290A0CEEFA9"

# ── Code generation (R-B7, R-B12) ─────────────────────────────────────────────
FLUTTER_RUST_BRIDGE_VERSION="1.80.1" # bridge.yml; built with --features "uuid" --locked → generated_bridge.dart / bridge_generated.rs

# ── Native deps via vcpkg overrides (§3.2; overlay ports in ./res/vcpkg) ───────
# R-R2b: the hardware-codec natives (ffmpeg + mfx-dispatch) and their hwaccel
# override pins (ffnvcodec, amd-amf) are PRUNED from vcpkg.json (CPU-only software
# codec, Appendix C #2b); they were also the multi-hour build that made the §12.2
# Windows VM build infeasible. scripts/verify.sh gates their absence.
# Overlay ports (patched, in res/vcpkg): libvpx libyuv opus
# Native set built from baseline: libvpx libyuv opus libjpeg-turbo oboe
#   cpu-features. Crypto is the sodiumoxide crate, NOT vcpkg.

# ── vcpkg overlay distfiles — source and patch pins (R-B12(a)) ────────────────
# libvpx retains the v1.15.2 source archive and applies the exact upstream
# d5f35ac8 security patch. Both byte streams are SHA512-pinned and captured by
# online-fetch; every target consumes that capture through a file://-only port.
LIBVPX_SOURCE_REF="v1.15.2"
SHA512_LIBVPX_SOURCE="824fe8719e4115ec359ae0642f5e1cea051d458f09eb8c24d60858cf082f66e411215e23228173ab154044bafbdfbb2d93b589bb726f55b233939b91f928aae0"
LIBVPX_FIX_COMMIT="d5f35ac8d93cba7f7a3f7ddb8f9dc8bd28f785e1"
SHA512_LIBVPX_PATCH="2980e0504e207047d55e6c98dcc55c2a3c06315b4ec04d59c42d786657e03ba0e1c73a0718ac6635990aac25fc642b204a1d56e13501ce2bd9625996ad0310d8"
SHA256_LIBVPX_WINDOWS_TOOLS_MANIFEST="c888ee51f816d8fb811ff5e62971b973449d0dadfef683d4cae83119f0e83a8e"
SHA256_VCPKG_FIXED_ARCHIVE_ACQUISITION="c90310083a22b9da7cebb9412275f3a551dd03f146fcf7f25fed84ab633b5a8f"

# libyuv fetches from
# googlesource, whose gitiles `+archive` tarballs are EMPIRICALLY non-reproducible
# (two fetches 4s apart differ — even the decompressed tar: gitiles re-timestamps/
# reorders), so its URL cannot be SHA-pinned, and R-R1 forbids vendoring the
# source. Instead online-fetch's stage_vcpkg_distfiles writes a REPRODUCIBLE
# `git -c core.autocrlf=false archive --format=tar <commit> | gzip -n` into ./online,
# and the overlay portfile consumes it SHA512-verified (file://) — falling back to
# the git-SHA-1 commit pin on hosts without the capture. The full commit SHA-1 is the upstream
# content anchor; the SHA512 binds the exact captured bytes. CAVEAT: the archive
# bytes depend on the builder image's git (these computed in the pinned deb-builder,
# git 2.17.1) — re-pin if that image's git changes (same class as the GitHub-archive
# caveat on SHA256_VCPKG_120DEAC3 below).
LIBYUV_COMMIT="0faf8dd0e004520a61a603a4d2996d5ecc80dc3f"       # libyuv chromium pin (res/vcpkg/libyuv/portfile.cmake)
SHA512_LIBYUV="be6b343ab6c62e8f2d1571fedf25f5facbf7cd7fe8e1cc4949dab7549ad15f962c91ea43bf567785e54382d7689514f6b66d61bd56b3f38ba54ef51c5fd0da9b"

# ── Windows packaging (§3.2) ──────────────────────────────────────────────────
WIX_TOOLSET_VERSION="4"              # WixToolset.Sdk/extensions 4.0.5; res/msi targets schemas/v4

# ── Per-target build config (exact, from build.py get_features) ────────────────
# Debian x86_64 : triple x86_64-unknown-linux-gnu  | triplet x64-linux           | features flutter,unix-file-copy-paste
# Android aarch64: triple aarch64-linux-android     | triplet arm64-android       | features flutter
# Windows x86_64 : triple x86_64-pc-windows-msvc    | triplet x64-windows-static  | features flutter
# Controlled-only profile (R-R2b): viewer OFF; decode/hwcodec/vram/flutter OFF (CPU-only encode).

