SHA256_VERIFIER_VM_VIRTIOFSD_BINARY="e256a63975f3ba343d651ce001fdc1f1128a5967612f0f102ab1387727ead140"

# Direct-boot identity derived read-only from the authenticated Debian image.
# Two independent sparse conversions and debugfs extractions from the pinned
# publisher-SHA512-exact qcow2 produced byte-identical kernel/initramfs files.
# The partition and filesystem pins ensure a different layout cannot silently
# redirect extraction even if a future image is accidentally paired with these
# file digests. These are focused-verifier boot assets, never host executables.
VERIFIER_VM_KERNEL_RELEASE="6.1.0-50-cloud-amd64"
