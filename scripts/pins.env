# The pinned Debian Bookworm genericcloud image deliberately omits Git. This
# exact Debian package is an inert bootstrap input: the host authenticates but
# never installs or executes it, and VM-local root extracts a read-only
# runtime without invoking apt or changing the base image. The package version,
# byte counts, and SHA-256 values below are the fields published by Debian's
# Bookworm package index on 2026-09-15.
VERIFIER_VM_GIT_PACKAGE_VERSION="1:2.39.5-0+deb12u3"
VERIFIER_VM_GIT_PACKAGE_FILENAME_VERSION="2.39.5-0+deb12u3"
