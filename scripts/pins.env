# device backend for R-S11dh; it is authenticated into private harness state,
# extracted without package installation, and never receives host root. The
# version, byte count, SHA-256 and SHA-512 below are the exact fields in
# Ubuntu's signed Noble Updates Packages index as checked on 2026-09-15. The
# package file list independently names /usr/libexec/virtiofsd.
VERIFIER_VM_VIRTIOFSD_VERSION="1.10.0"
VERIFIER_VM_VIRTIOFSD_PACKAGE_VERSION="1.10.0-1ubuntu0.1"
